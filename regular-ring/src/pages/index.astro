---
import Layout from '../layouts/Layout.astro';
import NavItem from '../components/NavItem.astro';
import CardReel from '../components/CardReel.astro';
import LinkSocial from '../components/LinkSocial.astro';
import '../styles/layout.css';

import avatar from '../assets/avatar-wesmarcal.png';
import wordmark from '../assets/wordmark.svg';
import reelThumb from '../assets/reel-thumb.jpg';
import iconLinkedin from '../assets/icon-linkedin.svg';
import iconSubstack from '../assets/icon-substack.svg';

const reels = [
  { title: 'Badaró', image: reelThumb },
  { title: 'iFood', image: reelThumb },
  { title: 'Zé Delivery', image: reelThumb },
  { title: 'Badaró', image: reelThumb },
  { title: 'Badaró', image: reelThumb },
];
---

<Layout title="Wes Marçal — Home">
  <div class="page-home">
    <div class="page-home__frame">
      <header class="page-home__header">
        <nav class="page-home__nav" aria-label="Principal">
          <NavItem label="home" href="/" active />
          <NavItem label="carreira" href="/carreira" />
        </nav>
        <p class="page-home__lang" aria-label="Idioma">
          <span class="page-home__lang-active">pt</span>
          <span class="page-home__lang-sep">  |  </span>
          <span class="page-home__lang-inactive">en</span>
        </p>
      </header>

      <section class="page-home__hero" aria-label="Apresentação">
        <div class="page-home__identity">
          <div class="page-home__avatar">
            <img
              src={avatar.src}
              width={avatar.width}
              height={avatar.height}
              alt="Retrato de Wes Marçal"
            />
          </div>
          <img
            class="page-home__wordmark"
            src={wordmark.src}
            width={wordmark.width}
            height={wordmark.height}
            alt="wes marçal"
          />
        </div>
        <div class="page-home__intro">
          <p class="page-home__eyebrow">Designer especialista • Designer engineer</p>
          <h1 class="page-home__headline">
            Uso design e AI para transformar problemas complexos de produto em decisões claras e
            rápidas.
          </h1>
        </div>
      </section>
    </div>

    <section class="page-home__reels" aria-label="Cases">
      {reels.map((reel) => <CardReel title={reel.title} image={reel.image} />)}
    </section>

    <div class="page-home__frame">
      <footer class="page-home__footer">
        <div class="page-home__socials">
          <LinkSocial
            label="linkedin.com/in/wesmarcal"
            href="https://linkedin.com/in/wesmarcal"
            icon={iconLinkedin}
          />
          <LinkSocial
            label="@wesmarcal"
            href="https://substack.com/@wesmarcal"
            icon={iconSubstack}
            gap={8}
          />
        </div>
        <div class="page-home__cta">
          <p class="page-home__cta-text">
            tô disponível para novas parcerias, mentorias e consultoria estratégica, vamos
            conversar!
          </p>
          <p class="page-home__cta-email">
            <a href="mailto:wes.marcal@gmail.com">wes.marcal@gmail.com</a>
          </p>
        </div>
      </footer>
    </div>
  </div>
</Layout>
