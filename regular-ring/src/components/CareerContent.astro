---
import { fade } from 'astro:transitions';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Identity from './Identity.astro';
import TimelineEntry from './TimelineEntry.astro';
import ArrowIcon from './ArrowIcon.astro';
import '../styles/shared.css';
import '../styles/career.css';

import { t, strings, type Locale } from '../i18n/strings';
import { careerTimeline } from '../i18n/career';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const timeline = careerTimeline[locale];
const langHrefs = { pt: strings.pt.navCareerHref, en: strings.en.navCareerHref };
---

<div class="page-career" transition:animate={fade({ duration: 280 })}>
  <div class="page-frame">
    <SiteHeader locale={locale} activePage="career" langHrefs={langHrefs} />

    <section class="page-career__hero" aria-label={s.hero}>
      <Identity locale={locale} />
      <div class="page-career__intro">
        <p class="page-career__eyebrow">{s.careerEyebrow}</p>
        <h1 class="page-career__headline">
          {s.careerHeadlineBefore}
          <span class="page-career__headline-arrow" aria-hidden="true"><ArrowIcon /></span>
          {s.careerHeadlineAfter}
        </h1>
      </div>
    </section>

    <section class="page-career__timeline" aria-label={s.careerTimelineLabel}>
      {timeline.map((entry, index) => <TimelineEntry {...entry} index={index} />)}
    </section>

    <SiteFooter locale={locale} />
  </div>
</div>

<script>
  import '../scripts/reveal';
</script>
