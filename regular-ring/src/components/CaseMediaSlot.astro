---
import type { ImageMetadata } from 'astro';

interface Props {
  caption: string;
  ratio: string;
  src?: ImageMetadata;
  alt?: string;
}

const { caption, ratio, src, alt = '' } = Astro.props;
const frameRatio = src ? `${src.width} / ${src.height}` : ratio;
const filled = Boolean(src);
---

<figure class:list={['case-media-slot', filled && 'case-media-slot--filled']} style={`--slot-ratio: ${frameRatio}`}>
  <div class="case-media-slot__frame" aria-hidden={filled ? undefined : 'true'}>
    {
      src ? (
        <img
          class="case-media-slot__image"
          src={src.src}
          width={src.width}
          height={src.height}
          alt={alt}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <>
          <span class="case-media-slot__corner case-media-slot__corner--tl"></span>
          <span class="case-media-slot__corner case-media-slot__corner--tr"></span>
          <span class="case-media-slot__corner case-media-slot__corner--bl"></span>
          <span class="case-media-slot__corner case-media-slot__corner--br"></span>
          <span class="case-media-slot__crosshair"></span>
        </>
      )
    }
  </div>
  <figcaption class="case-media-slot__caption">{caption}</figcaption>
</figure>

<style>
  .case-media-slot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .case-media-slot__frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--slot-ratio);
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-rule);
    background-image: repeating-linear-gradient(
        0deg,
        var(--color-rule) 0,
        var(--color-rule) 1px,
        transparent 1px,
        transparent 40px
      ),
      repeating-linear-gradient(
        90deg,
        var(--color-rule) 0,
        var(--color-rule) 1px,
        transparent 1px,
        transparent 40px
      );
    background-color: color-mix(in srgb, var(--color-ink) 60%, transparent);
    overflow: hidden;
  }

  .case-media-slot--filled .case-media-slot__frame {
    aspect-ratio: auto;
    background-image: none;
    background-color: transparent;
    border: none;
    border-radius: 0;
  }

  .case-media-slot__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .case-media-slot__corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: var(--border-width) solid var(--color-accent-muted);
  }

  .case-media-slot__corner--tl {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
  }

  .case-media-slot__corner--tr {
    top: -1px;
    right: -1px;
    border-left: none;
    border-bottom: none;
  }

  .case-media-slot__corner--bl {
    bottom: -1px;
    left: -1px;
    border-right: none;
    border-top: none;
  }

  .case-media-slot__corner--br {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
  }

  .case-media-slot__crosshair {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 22px;
    height: 22px;
  }

  .case-media-slot__crosshair::before,
  .case-media-slot__crosshair::after {
    content: '';
    position: absolute;
    background: var(--color-text-muted);
  }

  .case-media-slot__crosshair::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: translateY(-50%);
  }

  .case-media-slot__crosshair::after {
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    transform: translateX(-50%);
  }

  .case-media-slot__caption {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-light);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-transparency: reduce) {
    .case-media-slot__frame {
      background-color: var(--color-ink);
    }

    .case-media-slot--filled .case-media-slot__frame {
      background-color: transparent;
    }
  }
</style>
