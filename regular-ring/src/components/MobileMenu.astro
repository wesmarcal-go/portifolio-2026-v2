---
import type { ImageMetadata } from 'astro';
import LinkSocial from './LinkSocial.astro';
import LangSwitch from './LangSwitch.astro';
import ArrowIcon from './ArrowIcon.astro';
import type { Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
  activePage: 'home' | 'career' | 'cases';
  langLabel: string;
  navPrimary: string;
  navHomeLabel: string;
  navHomeHref: string;
  navCareerLabel: string;
  navCareerHref: string;
  navCasesLabel: string;
  navCasesHref: string;
  menuLabel: string;
  menuOpenLabel: string;
  menuCloseLabel: string;
  linkedinLabel: string;
  linkedinHref: string;
  substackLabel: string;
  substackHref: string;
  iconLinkedin: ImageMetadata;
  iconSubstack: ImageMetadata;
}

const {
  locale,
  activePage,
  langLabel,
  navPrimary,
  navHomeLabel,
  navHomeHref,
  navCareerLabel,
  navCareerHref,
  navCasesLabel,
  navCasesHref,
  menuLabel,
  menuOpenLabel,
  menuCloseLabel,
  linkedinLabel,
  linkedinHref,
  substackLabel,
  substackHref,
  iconLinkedin,
  iconSubstack,
} = Astro.props;
---

<button
  class="menu-trigger"
  id="menu-trigger"
  type="button"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="mobile-menu"
>
  <span class="menu-trigger__bar" aria-hidden="true"></span>
  <span class="menu-trigger__bar" aria-hidden="true"></span>
  <span class="sr-only">{menuOpenLabel}</span>
</button>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label={menuLabel} hidden>
  <div class="mobile-menu__header">
    <LangSwitch locale={locale} label={langLabel} />
    <button class="mobile-menu__close" id="menu-close" type="button">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 2L16 16M16 2L2 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <span class="sr-only">{menuCloseLabel}</span>
    </button>
  </div>

  <nav class="mobile-menu__nav" aria-label={navPrimary}>
    <a
      class:list={['mobile-menu__link', { 'mobile-menu__link--active': activePage === 'home' }]}
      href={navHomeHref}
      aria-current={activePage === 'home' ? 'page' : undefined}
    >
      <span class="mobile-menu__link-icon" aria-hidden="true">
        <ArrowIcon />
      </span>
      <span class="mobile-menu__link-label">{navHomeLabel}</span>
    </a>
    <a
      class:list={['mobile-menu__link', { 'mobile-menu__link--active': activePage === 'career' }]}
      href={navCareerHref}
      aria-current={activePage === 'career' ? 'page' : undefined}
    >
      <span class="mobile-menu__link-icon" aria-hidden="true">
        <ArrowIcon />
      </span>
      <span class="mobile-menu__link-label">{navCareerLabel}</span>
    </a>
    <a
      class:list={['mobile-menu__link', { 'mobile-menu__link--active': activePage === 'cases' }]}
      href={navCasesHref}
      aria-current={activePage === 'cases' ? 'page' : undefined}
    >
      <span class="mobile-menu__link-icon" aria-hidden="true">
        <ArrowIcon />
      </span>
      <span class="mobile-menu__link-label">{navCasesLabel}</span>
    </a>
  </nav>

  <div class="mobile-menu__socials">
    <LinkSocial label={linkedinLabel} href={linkedinHref} icon={iconLinkedin} large />
    <LinkSocial label={substackLabel} href={substackHref} icon={iconSubstack} gap={8} large />
  </div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .menu-trigger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
    transition: transform var(--duration-press) var(--ease-out);
  }

  .menu-trigger:active {
    transform: scale(0.9);
  }

  .menu-trigger__bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-text);
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
  }

  .menu-trigger[aria-expanded='true'] .menu-trigger__bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-trigger[aria-expanded='true'] .menu-trigger__bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    flex-direction: column;
    background: var(--color-background);
    padding: 0 var(--spacing-lg);
    opacity: 0;
    transform: scale(0.98) translateY(-8px);
    transform-origin: top left;
    transition: opacity var(--duration-menu-exit) var(--ease-out),
      transform var(--duration-menu-exit) var(--ease-out);
  }

  .mobile-menu:not([hidden]) {
    display: flex;
  }

  .mobile-menu.is-open {
    opacity: 1;
    transform: scale(1) translateY(0);
    transition-duration: var(--duration-menu-enter);
  }

  .mobile-menu__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 88px;
    flex-shrink: 0;
  }

  .mobile-menu__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    transition: transform var(--duration-press) var(--ease-out);
  }

  .mobile-menu__close:active {
    transform: scale(0.9) rotate(90deg);
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    padding-top: var(--spacing-xl);
    gap: 4px;
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-family-sans);
    font-size: clamp(2rem, 10vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -1px;
    color: var(--color-text);
    padding-block: 10px;
    transition: color var(--duration-fast) var(--ease-out), transform var(--duration-press) var(--ease-out);
  }

  .mobile-menu__link:active {
    transform: scale(0.97);
    color: var(--color-accent);
  }

  .mobile-menu__link--active {
    color: var(--color-accent);
  }

  .mobile-menu__link:active .mobile-menu__link-icon {
    transform: translateX(2px);
  }

  .mobile-menu__link-icon {
    display: flex;
    width: 0.8em;
    height: 0.8em;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .mobile-menu__link-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .mobile-menu__socials {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    padding-block: var(--spacing-xl);
  }

  @media (hover: hover) and (pointer: fine) {
    .mobile-menu__link:hover {
      color: var(--color-accent);
    }

    .mobile-menu__link:hover .mobile-menu__link-icon {
      transform: translateX(2px);
    }
  }

  @media (min-width: 901px) {
    .menu-trigger,
    .mobile-menu {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .menu-trigger {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transform: none;
    }
    .mobile-menu.is-open {
      transform: none;
    }
  }
</style>

<script>
  // Astro's ClientRouter swaps the DOM on client-side navigation without
  // re-running this script, so setup must happen on every 'astro:page-load'
  // (fired after the initial load and after every subsequent transition),
  // not just once at module scope.
  let activeKeydownHandler: ((event: KeyboardEvent) => void) | null = null;

  const setupMobileMenu = () => {
    const trigger = document.getElementById('menu-trigger') as HTMLButtonElement | null;
    const menu = document.getElementById('mobile-menu') as HTMLElement | null;
    const closeBtn = document.getElementById('menu-close') as HTMLButtonElement | null;

    if (!trigger || !menu || !closeBtn) return;

    // Guard against a stale document-level listener from a previous page
    // (e.g. the user navigated away via a link inside the menu without it
    // ever closing).
    if (activeKeydownHandler) {
      document.removeEventListener('keydown', activeKeydownHandler);
      activeKeydownHandler = null;
    }

    let lastFocused: HTMLElement | null = null;

    const getFocusable = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        closeMenu();
        return;
      }
      if (event.key === 'Tab') {
        const focusable = getFocusable();
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    };

    const openMenu = () => {
      lastFocused = document.activeElement as HTMLElement;
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add('is-open'));
      trigger.setAttribute('aria-expanded', 'true');
      document.body.classList.add('menu-open');
      closeBtn.focus();
      activeKeydownHandler = onKeydown;
      document.addEventListener('keydown', onKeydown);
    };

    const closeMenu = () => {
      menu.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
      document.removeEventListener('keydown', onKeydown);
      activeKeydownHandler = null;
      lastFocused?.focus();

      const onEnd = (event: TransitionEvent) => {
        if (event.target !== menu) return;
        menu.hidden = true;
        menu.removeEventListener('transitionend', onEnd);
      };
      menu.addEventListener('transitionend', onEnd);
    };

    trigger.addEventListener('click', () => {
      if (menu.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn.addEventListener('click', closeMenu);
    menu.querySelectorAll('.mobile-menu__link').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  };

  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
