---
import { fade } from 'astro:transitions';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Identity from './Identity.astro';
import '../styles/shared.css';
import '../styles/cases.css';

import slideIfood from '../assets/slide-ifood.png';
import slideZeDelivery from '../assets/slide-ze-delivery.png';
import slideGrupoGlobo from '../assets/slide-grupo-globo.png';
import iconLock from '../assets/icon-lock.svg';

import { t, strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);

const gridItems = [slideIfood, slideZeDelivery, slideGrupoGlobo];
const langHrefs = { pt: strings.pt.navCasesHref, en: strings.en.navCasesHref };
---

<div class="page-cases" transition:animate={fade({ duration: 280 })}>
  <div class="page-frame">
    <SiteHeader locale={locale} activePage="cases" langHrefs={langHrefs} />

    <section class="page-cases__hero" aria-label={s.hero}>
      <Identity locale={locale} />
      <div class="page-cases__intro">
        <p class="page-cases__eyebrow">{s.casesEyebrow}</p>
        <h1 class="page-cases__headline">{s.casesHeadline}</h1>
      </div>
    </section>
  </div>

  <section
    class="page-cases__stage page-frame"
    aria-label={s.casesGridLabel}
    data-component="cases-preview-grid"
  >
    <div class="page-cases__grid">
      {
        gridItems.map((image, index) => {
          const unlocked = index === 0;
          return (
            <div
              class:list={[
                'page-cases__cell',
                unlocked ? 'page-cases__cell--unlocked' : 'page-cases__cell--locked',
              ]}
              style={`--cell-index: ${index}`}
            >
              {unlocked ? (
                <a
                  class="page-cases__tile-link"
                  href={s.casesUnlockedHref}
                  aria-label={s.casesUnlockedLabel}
                >
                  <img
                    class="page-cases__image"
                    src={image.src}
                    width={image.width}
                    height={image.height}
                    alt=""
                    loading="eager"
                    decoding="async"
                  />
                </a>
              ) : (
                <>
                  <img
                    class="page-cases__image"
                    src={image.src}
                    width={image.width}
                    height={image.height}
                    alt=""
                    loading="eager"
                    decoding="async"
                    aria-hidden="true"
                  />
                  <div class="page-cases__cell-scrim" aria-hidden="true"></div>
                  <span class="page-cases__lock" aria-label={s.casesLockedLabel} role="img">
                    <img
                      class="page-cases__lock-icon"
                      src={iconLock.src}
                      width={32}
                      height={32}
                      alt=""
                      aria-hidden="true"
                    />
                  </span>
                </>
              )}
            </div>
          );
        })
      }
    </div>
  </section>

  <div class="page-frame">
    <SiteFooter locale={locale} />
  </div>
</div>
