---
import slideZeDelivery from '../assets/slide-ze-delivery.png';
import slideGrupoGlobo from '../assets/slide-grupo-globo.png';
import caseIfoodPoster from '../assets/case-ifood-thumb-poster.jpg';
import { t, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
  /** When true, cells use scroll-reveal instead of load enter. */
  reveal?: boolean;
}

const { locale, reveal = false } = Astro.props;
const s = t(locale);

const lockedItems = [slideZeDelivery, slideGrupoGlobo];
---

<section
  class="cases-preview"
  data-component="cases-preview-grid"
  aria-label={s.casesGridLabel}
>
  <div
    class="cases-preview__cell cases-preview__cell--unlocked"
    style="--cell-index: 0"
    data-reveal={reveal ? true : undefined}
  >
    <a
      class="cases-preview__tile-link"
      href={s.casesUnlockedHref}
      aria-label={s.casesUnlockedLabel}
    >
      <video
        class="cases-preview__image cases-preview__video"
        data-play-on-visible
        data-playback-rate="0.55"
        loop
        muted
        playsinline
        preload="metadata"
        poster={caseIfoodPoster.src}
        width={caseIfoodPoster.width}
        height={caseIfoodPoster.height}
        aria-hidden="true"
      >
        <source src="/videos/case-ifood-thumb.mp4" type="video/mp4" />
      </video>
      <div class="cases-preview__video-scrim" aria-hidden="true"></div>
      <div class="cases-preview__caption">
        <p class="cases-preview__caption-title">{s.casesUnlockedTitle}</p>
        <ul class="cases-preview__tags">
          {
            s.casesUnlockedTags.map((tag) => (
              <li class="cases-preview__tag">{tag}</li>
            ))
          }
        </ul>
      </div>
    </a>
  </div>
  {
    lockedItems.map((image, index) => (
      <div
        class="cases-preview__cell cases-preview__cell--locked"
        style={`--cell-index: ${index + 1}`}
        data-reveal={reveal ? true : undefined}
      >
        <img
          class="cases-preview__image"
          src={image.src}
          width={image.width}
          height={image.height}
          alt=""
          loading={reveal ? 'lazy' : 'eager'}
          decoding="async"
          aria-hidden="true"
        />
        <div class="cases-preview__cell-scrim" aria-hidden="true"></div>
        <span class="cases-preview__soon">{s.casesLockedLabel}</span>
      </div>
    ))
  }
</section>

<script>
  import '../scripts/play-on-visible';
</script>
