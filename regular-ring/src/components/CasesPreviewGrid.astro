---
import slideIfood from '../assets/slide-ifood.png';
import slideZeDelivery from '../assets/slide-ze-delivery.png';
import slideGrupoGlobo from '../assets/slide-grupo-globo.png';
import iconLock from '../assets/icon-lock.svg';
import { t, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
  /** When true, cells use scroll-reveal instead of load enter. */
  reveal?: boolean;
}

const { locale, reveal = false } = Astro.props;
const s = t(locale);

const gridItems = [slideIfood, slideZeDelivery, slideGrupoGlobo];
---

<section
  class="cases-preview"
  data-component="cases-preview-grid"
  aria-label={s.casesGridLabel}
>
  {
    gridItems.map((image, index) => {
      const unlocked = index === 0;
      return (
        <div
          class:list={[
            'cases-preview__cell',
            unlocked ? 'cases-preview__cell--unlocked' : 'cases-preview__cell--locked',
          ]}
          style={`--cell-index: ${index}`}
          data-reveal={reveal ? true : undefined}
        >
          {unlocked ? (
            <a
              class="cases-preview__tile-link"
              href={s.casesUnlockedHref}
              aria-label={s.casesUnlockedLabel}
            >
              <img
                class="cases-preview__image"
                src={image.src}
                width={image.width}
                height={image.height}
                alt=""
                loading={reveal ? 'lazy' : 'eager'}
                decoding="async"
              />
            </a>
          ) : (
            <>
              <img
                class="cases-preview__image"
                src={image.src}
                width={image.width}
                height={image.height}
                alt=""
                loading={reveal ? 'lazy' : 'eager'}
                decoding="async"
                aria-hidden="true"
              />
              <div class="cases-preview__cell-scrim" aria-hidden="true"></div>
              <span class="cases-preview__lock" aria-label={s.casesLockedLabel} role="img">
                <img
                  class="cases-preview__lock-icon"
                  src={iconLock.src}
                  width={32}
                  height={32}
                  alt=""
                  aria-hidden="true"
                />
              </span>
            </>
          )}
        </div>
      );
    })
  }
</section>
