---
import NavItem from './NavItem.astro';
import LangSwitch from './LangSwitch.astro';
import MobileMenu from './MobileMenu.astro';
import { t, localePaths, type Locale } from '../i18n/strings';
import { SOCIAL_LINKS } from '../lib/site';
import iconLinkedin from '../assets/icon-linkedin.svg';
import iconSubstack from '../assets/icon-substack.svg';

interface Props {
  locale: Locale;
  activePage: 'home' | 'career' | 'cases';
  langHrefs?: { pt: string; en: string };
}

const { locale, activePage, langHrefs } = Astro.props;
const s = t(locale);

const linkedinHref = SOCIAL_LINKS.linkedin;
const substackHref = SOCIAL_LINKS.substack;
---

<header class="page-header">
  <div class="page-header__nav-area">
    <nav class="page-header__nav" aria-label={s.navPrimary}>
      <NavItem label={s.navHome} href={localePaths[locale]} active={activePage === 'home'} />
      <NavItem label={s.navCareer} href={s.navCareerHref} active={activePage === 'career'} />
      <NavItem label={s.navCases} href={s.navCasesHref} active={activePage === 'cases'} />
    </nav>
    <MobileMenu
      locale={locale}
      activePage={activePage}
      langLabel={s.langLabel}
      navPrimary={s.navPrimary}
      navHomeLabel={s.navHome}
      navHomeHref={localePaths[locale]}
      navCareerLabel={s.navCareer}
      navCareerHref={s.navCareerHref}
      navCasesLabel={s.navCases}
      navCasesHref={s.navCasesHref}
      menuLabel={s.menuLabel}
      menuOpenLabel={s.menuOpen}
      menuCloseLabel={s.menuClose}
      linkedinLabel="linkedin.com/in/wesmarcal"
      linkedinHref={linkedinHref}
      substackLabel="@wesmarcal"
      substackHref={substackHref}
      iconLinkedin={iconLinkedin}
      iconSubstack={iconSubstack}
      langHrefs={langHrefs}
    />
  </div>
  <LangSwitch locale={locale} label={s.langLabel} ptHref={langHrefs?.pt} enHref={langHrefs?.en} />
</header>

<style>
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88px;
    padding: 0 var(--spacing-lg);
  }

  .page-header__nav-area {
    display: flex;
    align-items: center;
  }

  .page-header__nav {
    display: flex;
    align-items: center;
    gap: 38px;
  }

  @media (max-width: 900px) {
    .page-header__nav {
      display: none;
    }

    .page-header {
      justify-content: flex-end;
    }

    .page-header > :global(.lang-switch) {
      display: none;
    }
  }
</style>
