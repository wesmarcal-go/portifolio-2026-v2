---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  label: string;
  href: string;
  active?: boolean;
}

const { label, href, active = false } = Astro.props;
---

<a
  class:list={['nav-item', { 'nav-item--active': active }]}
  href={href}
  data-component="nav-item"
  aria-current={active ? 'page' : undefined}
>
  <span class="nav-item__icon" aria-hidden="true">
    <ArrowIcon />
  </span>
  <span class="nav-item__label">{label}</span>
</a>

<style>
  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    color: var(--color-accent-muted);
    font-family: var(--font-family-sans);
    font-size: var(--font-size-nav);
    font-weight: var(--font-weight-bold);
    letter-spacing: -1px;
    line-height: 28px;
    white-space: nowrap;
    padding-block: 8px;
    margin-block: -8px;
    transition: color var(--duration-fast) var(--ease-out), transform var(--duration-press) var(--ease-out);
  }

  .nav-item:active {
    transform: scale(0.96);
  }

  .nav-item:active .nav-item__icon {
    transform: translateX(2px);
  }

  .nav-item--active {
    color: var(--color-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-item:not(.nav-item--active):hover {
      color: var(--color-accent);
    }

    .nav-item:hover .nav-item__icon {
      transform: translateX(2px);
    }
  }

  .nav-item__icon {
    display: flex;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .nav-item__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
