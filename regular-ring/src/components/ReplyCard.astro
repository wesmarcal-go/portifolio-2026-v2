---
import { CONTACT_EMAIL } from '../lib/site';
import { recipients, reply } from '../i18n/mentoria';

interface Props {
  endpoint: string;
}

const { endpoint } = Astro.props;
---

<div class="reply-card" id="responder" data-component="reply-card" data-state="idle" data-reveal>
  <div class="reply-card__intro">
    <p class="reply-card__eyebrow">{reply.eyebrow}</p>
    <h2 class="reply-card__heading" id="reply-heading">{reply.heading}</h2>
    <p class="reply-card__body">{reply.body}</p>
  </div>

  <form class="reply-card__form" data-endpoint={endpoint} novalidate>
    <div class="reply-card__field">
      <label for="reply-name">{reply.fields.name.label}</label>
      <input
        id="reply-name"
        name="nome"
        type="text"
        autocomplete="name"
        required
        placeholder={reply.fields.name.placeholder}
        aria-describedby="reply-name-error"
      />
      <p class="reply-card__error" id="reply-name-error" role="alert" hidden></p>
    </div>

    <div class="reply-card__field">
      <label for="reply-email">{reply.fields.email.label}</label>
      <input
        id="reply-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        placeholder={reply.fields.email.placeholder}
        aria-describedby="reply-email-error"
      />
      <p class="reply-card__error" id="reply-email-error" role="alert" hidden></p>
    </div>

    <div class="reply-card__field">
      <label for="reply-track">{reply.fields.track.label}</label>
      <select id="reply-track" name="trilha" required>
        {recipients.map((recipient) => (
          <option value={recipient.id}>{recipient.chipLabel}</option>
        ))}
      </select>
    </div>

    <div class="reply-card__field reply-card__field--full">
      <label for="reply-context">{reply.fields.context.label}</label>
      <textarea
        id="reply-context"
        name="contexto"
        rows="3"
        required
        placeholder={reply.fields.context.placeholder}
        aria-describedby="reply-context-error"
      ></textarea>
      <p class="reply-card__error" id="reply-context-error" role="alert" hidden></p>
    </div>

    <div class="reply-card__honeypot" aria-hidden="true">
      <label for="reply-empresa">{reply.fields.honeypot.label}</label>
      <input id="reply-empresa" name="empresa" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="origem" data-field="origem" />
    <input type="hidden" name="campanha" data-field="campanha" />
    <input type="hidden" name="carregadoEm" data-field="carregadoEm" />

    <button type="submit" class="reply-card__submit">
      <span data-label-idle>{reply.submitLabel}</span>
      <span data-label-pending hidden>{reply.submitLabelPending}</span>
    </button>
  </form>

  <div class="reply-card__result reply-card__result--success" role="status" hidden>
    <p class="reply-card__result-heading">{reply.success.heading}</p>
    <p class="reply-card__result-body">{reply.success.body}</p>
  </div>

  <div class="reply-card__result reply-card__result--error" role="alert" hidden>
    <p class="reply-card__result-heading">{reply.error.heading}</p>
    <p class="reply-card__result-body">{reply.error.body}</p>
    <a class="reply-card__mailto" data-mailto href={`mailto:${CONTACT_EMAIL}`}>{reply.error.mailLinkLabel}</a>
  </div>

  <noscript>
    <p class="reply-card__noscript">
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  </noscript>
</div>

<style>
  .reply-card {
    --reply-fill: color-mix(in srgb, var(--color-linen) 5%, transparent);
    --reply-edge: color-mix(in srgb, var(--color-linen) 18%, transparent);
    --reply-glow-peach: color-mix(in srgb, var(--color-peach) 14%, transparent);
    --reply-glow-pine: color-mix(in srgb, var(--color-pine) 22%, transparent);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-block);
    width: 100%;
    max-width: var(--measure);
    box-sizing: border-box;
    padding: var(--spacing-block) clamp(1.25rem, 3vw, 2rem);
    border: var(--border-width) solid var(--reply-edge);
    border-radius: var(--radius-md);
    background: var(--reply-fill);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    container-type: inline-size;
    container-name: reply-card;
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .reply-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .reply-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 55% at 0% 0%, var(--reply-glow-peach), transparent 62%),
      radial-gradient(ellipse 55% 45% at 100% 100%, var(--reply-glow-pine), transparent 58%),
      radial-gradient(ellipse 40% 35% at 85% 15%, color-mix(in srgb, var(--color-cognac) 10%, transparent), transparent 55%);
  }

  .reply-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-linen) 22%, transparent);
  }

  .reply-card__intro {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .reply-card__eyebrow {
    margin: 0;
    font-family: var(--font-family-serif);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-normal);
    line-height: 1.4;
    color: var(--color-accent);
  }

  .reply-card__heading {
    margin: 0;
    font-family: var(--font-family-serif);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: var(--font-weight-normal);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .reply-card__body {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-light);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .reply-card__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md) var(--spacing-lg);
  }

  .reply-card__field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .reply-card__field--full {
    grid-column: 1 / -1;
  }

  .reply-card__field label,
  .reply-card__honeypot label {
    font-family: var(--font-family-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .reply-card__field input,
  .reply-card__field select,
  .reply-card__field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 10px var(--spacing-sm);
    border: var(--border-width) solid var(--reply-edge);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-ink) 32%, transparent);
    color: var(--color-text);
    font-family: var(--font-family-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-normal);
    line-height: 1.4;
  }

  .reply-card__field textarea {
    resize: vertical;
    min-height: 4.5em;
  }

  .reply-card__field input::placeholder,
  .reply-card__field textarea::placeholder {
    color: color-mix(in srgb, var(--color-text-muted) 80%, transparent);
  }

  .reply-card__field input:focus-visible,
  .reply-card__field select:focus-visible,
  .reply-card__field textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .reply-card__field :is(input, select, textarea)[aria-invalid='true'] {
    border-color: var(--color-accent);
  }

  .reply-card__error {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-normal);
    color: var(--color-accent);
  }

  .reply-card__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .reply-card__submit {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 18px;
    border: none;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-ink);
    font-family: var(--font-family-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    cursor: pointer;
    transition: transform var(--duration-press) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
  }

  .reply-card__submit:active {
    transform: scale(0.97);
  }

  .reply-card__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .reply-card__submit:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .reply-card__result {
    display: none;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .reply-card[data-state='success'] .reply-card__result--success,
  .reply-card[data-state='error'] .reply-card__result--error {
    display: flex;
  }

  .reply-card__result-heading {
    margin: 0;
    font-family: var(--font-family-serif);
    font-size: var(--font-size-lg);
    color: var(--color-text);
  }

  .reply-card__result-body {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-light);
    line-height: var(--line-height-body);
    color: var(--color-text-muted);
  }

  .reply-card__mailto {
    align-self: flex-start;
    color: var(--color-accent);
    font-family: var(--font-family-sans);
    font-weight: var(--font-weight-normal);
  }

  .reply-card__noscript {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .reply-card__noscript a {
    color: var(--color-accent);
  }

  .reply-card[data-state='pending'] .reply-card__submit [data-label-idle] {
    display: none;
  }

  .reply-card[data-state='pending'] .reply-card__submit [data-label-pending] {
    display: inline;
  }

  .reply-card[data-state='success'] .reply-card__form,
  .reply-card[data-state='success'] .reply-card__intro,
  .reply-card[data-state='error'] .reply-card__form {
    display: none;
  }

  @container reply-card (max-width: 420px) {
    .reply-card__form {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .reply-card {
      background: color-mix(in srgb, var(--color-linen) 8%, var(--color-ink));
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .reply-card::before {
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reply-card {
      transform: none;
      transition: opacity 200ms ease;
    }
  }
</style>
