---
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<section class="letter-movement" id={id} aria-labelledby={`${id}-label`} data-reveal>
  <div class="page-frame letter-movement__frame">
    <p class="letter-movement__rail" id={`${id}-label`}>{label}</p>
    <div class="letter-movement__content">
      <slot />
    </div>
  </div>
</section>

<style>
  .letter-movement {
    width: 100%;
    padding-block: var(--spacing-xl);
    border-top: var(--border-width) solid var(--color-rule);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }

  .letter-movement.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .letter-movement__frame {
    display: grid;
    grid-template-columns: 222px 1fr;
    column-gap: var(--spacing-xl);
    padding-inline: var(--spacing-lg);
  }

  .letter-movement__rail {
    margin: 0;
    align-self: start;
    position: sticky;
    top: var(--spacing-lg);
    font-family: var(--font-family-sans);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-muted);
  }

  .letter-movement__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    max-width: var(--measure);
    min-width: 0;
    font-family: var(--font-family-serif);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-normal);
    line-height: var(--line-height-body);
    color: var(--color-text);
  }

  .letter-movement__content :global(p) {
    margin: 0;
  }

  @media (max-width: 900px) {
    .letter-movement__frame {
      grid-template-columns: 1fr;
      row-gap: var(--spacing-sm);
    }

    .letter-movement__rail {
      position: static;
    }
  }

  @media (max-width: 480px) {
    .letter-movement__frame {
      padding-inline: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .letter-movement {
      transform: none;
      transition: opacity var(--duration-base) var(--ease-out);
    }
  }
</style>
